# Hermes Relay 的环境变量 —— 全部可选，不设就走默认值。
# 用法：复制成 .env 后按需修改；systemd 里用 EnvironmentFile=/path/to/.env，或启动前 source 它。

# ---------- Hermes 本体（后端要 import 它，路径必须对） ----------
# Hermes 安装目录（默认 /usr/local/lib/hermes-agent）
HERMES_AGENT_DIR=/usr/local/lib/hermes-agent

# Hermes 的数据目录：会话库、config.yaml、技能都在这里（默认 ~/.hermes）
HERMES_HOME=/home/you/.hermes

# 会话库路径（默认 $HERMES_HOME/state.db）
# HERMES_STATE_DB=/home/you/.hermes/state.db

# ---------- 后端服务 ----------
# 监听地址与端口（默认 127.0.0.1:8788）。默认只监听回环，外部访问交给 nginx
# HERMES_RELAY_HOST=127.0.0.1
# HERMES_RELAY_PORT=8788

# 附件与运行数据目录：uploads/、metrics.json 等（默认 $HERMES_HOME/hermes-relay/uploads）
# HERMES_RELAY_UPLOADS=/home/you/.hermes/hermes-relay/uploads

# 模型 / 渠道配置文件（默认 $HERMES_HOME/hermes-relay/models.json）
# HERMES_RELAY_MODELS=/home/you/.hermes/hermes-relay/models.json

# 后端兜底吐静态页面的目录（默认仓库里的 static/；前后端分离部署时不用管）
# HERMES_RELAY_STATIC=/opt/hermes-relay/static

# ---------- 前端（一般由 systemd 单元设置，不用写在这里） ----------
# NODE_ENV=production
# PORT=3220
# HOSTNAME=127.0.0.1
